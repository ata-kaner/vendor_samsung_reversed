package vendor.samsung.hardware.thermal@1.0;

import types;

interface ISehThermalChangedCallback {
    /**
     * Send thermal callback to listeners when temperatures change.
     *
     * @param temperatures Vector of current Samsung thermal temperatures.
     */
    oneway notifyTemperatures(vec<SehTemperature> temperatures);
};
