cc_binary {
    name: "vendor.samsung.hardware.thermal@1.0-service",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["vendor.samsung.hardware.thermal@1.0-service.rc"],
    vintf_fragments: ["vendor.samsung.hardware.thermal@1.0-manifest.xml"],
    local_include_dirs: [
        "include",
        ".",
    ],
    srcs: [
        "BootControl.cpp",
        "IntervalTimer.cpp",
        "Predictor.cpp",
        "SehThermal.cpp",
        "TemperatureProvider.cpp",
        "Thermistors.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.thermal@1.0",
        "android.hardware.thermal@2.0",
        "libcutils",
        "libbase",
        "libhidlbase",
        "libhypervintf",
        "libjsoncpp",
        "liblog",
        "libutils",
        "vendor.samsung.hardware.thermal@1.0",
    ],
}
