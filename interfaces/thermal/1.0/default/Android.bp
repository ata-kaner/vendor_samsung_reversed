soong_config_module_type {
    name: "samsung_thermal_cc_binary",
    module_type: "cc_binary",
    config_namespace: "samsung_thermal",
    variables: ["soc_type"],
    properties: [
        "cflags",
        "shared_libs",
    ],
}

soong_config_variable {
    name: "soc_type",
    values: ["qcom", "exynos"],
}

samsung_thermal_cc_binary {
    name: "vendor.samsung.hardware.thermal@1.0-service",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["vendor.samsung.hardware.thermal@1.0-service.rc"],
    vintf_fragments: ["vendor.samsung.hardware.thermal@1.0-manifest.xml"],
    local_include_dirs: [
        "include",
        ".",
    ],
    srcs: [
        "BootControl.cpp",
        "IntervalTimer.cpp",
        "Predictor.cpp",
        "SehThermal.cpp",
        "TemperatureProvider.cpp",
        "Thermistors.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.thermal@1.0",
        "android.hardware.thermal@2.0",
        "libcutils",
        "libbase",
        "libhidlbase",
        "libhypervintf",
        "libjsoncpp",
        "liblog",
        "libutils",
        "vendor.samsung.hardware.thermal@1.0",
    ],
    soong_config_variables: {
        soc_type: {
            qcom: {
                cflags: ["-DTARGET_USES_QCOM_THERMAL"],
            },
            exynos: {
                cflags: ["-DTARGET_USES_EXYNOS_THERMAL"],
                shared_libs: ["libsecril-client"],
            },
        },
    },
}

// Standalone target pre-configured for Qualcomm (r8q / Snapdragon 865)
cc_binary {
    name: "vendor.samsung.hardware.thermal@1.0-service.qcom",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    cflags: ["-DTARGET_USES_QCOM_THERMAL"],
    init_rc: ["vendor.samsung.hardware.thermal@1.0-service.rc"],
    vintf_fragments: ["vendor.samsung.hardware.thermal@1.0-manifest.xml"],
    local_include_dirs: [
        "include",
        ".",
    ],
    srcs: [
        "BootControl.cpp",
        "IntervalTimer.cpp",
        "Predictor.cpp",
        "SehThermal.cpp",
        "TemperatureProvider.cpp",
        "Thermistors.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.thermal@1.0",
        "android.hardware.thermal@2.0",
        "libcutils",
        "libbase",
        "libhidlbase",
        "libhypervintf",
        "libjsoncpp",
        "liblog",
        "libutils",
        "vendor.samsung.hardware.thermal@1.0",
    ],
}

// Standalone target pre-configured for Exynos (x1s / Exynos 990)
cc_binary {
    name: "vendor.samsung.hardware.thermal@1.0-service.exynos",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    cflags: ["-DTARGET_USES_EXYNOS_THERMAL"],
    init_rc: ["vendor.samsung.hardware.thermal@1.0-service.rc"],
    vintf_fragments: ["vendor.samsung.hardware.thermal@1.0-manifest.xml"],
    local_include_dirs: [
        "include",
        ".",
    ],
    srcs: [
        "BootControl.cpp",
        "IntervalTimer.cpp",
        "Predictor.cpp",
        "SehThermal.cpp",
        "TemperatureProvider.cpp",
        "Thermistors.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.thermal@1.0",
        "android.hardware.thermal@2.0",
        "libcutils",
        "libbase",
        "libhidlbase",
        "libhypervintf",
        "libjsoncpp",
        "liblog",
        "libsecril-client",
        "libutils",
        "vendor.samsung.hardware.thermal@1.0",
    ],
}
