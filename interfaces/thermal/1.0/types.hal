package vendor.samsung.hardware.thermal@1.0;

enum SehTemperatureType : int32_t {
    CPU = 0,
    GPU = 1,
    BATTERY = 2,
    SKIN = 3,
    USB_PORT = 4,
    POWER_AMPLIFIER = 5,
    BCL_VOLTAGE = 6,
    BCL_CURRENT = 7,
    BCL_PERCENTAGE = 8,
    NPU = 9,
    SEH_MODEM = 50,
    SEH_CHARGER = 51,
    SEH_WIFI = 52,
    SEH_FLASH = 53,
    SEH_BACK = 54,
};

struct SehTemperature {
    SehTemperatureType type;
    string name;
    float currentValue;
};
